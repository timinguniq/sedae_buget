# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
Thumbs.db
desktop.ini
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/app/src/main/res/values/strings.xml

android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Dotenv
*.env
.env*
!.env.example

# Signing & credentials (never commit)
# android/.gitignore covers these under android/ only — these catch them anywhere.
*.jks
*.keystore
key.properties
*.p12
*.p8
*.pem
*.cer
*.certSigningRequest
*.mobileprovision

# Release binaries
*.apk
*.aab
*.ipa

# functions
/functions/*
/firebase.json
/firestore.rules
/.firebaserc

# screenshots
/screenshots

# docs — 설계 문서는 비공개. 구조·하네스 문서와 API 계약만 추적한다.
/docs/*
!/docs/architecture.md
!/docs/harness.md
!/docs/api-contract.md

# Claude Code — 공통 훅·에이전트 설정만 추적한다. 개인 설정(settings.local.json 등)은 제외.
.claude/*
!.claude/settings.json
!.claude/agents/

# Codex — 공통 훅 등록만 추적한다. 개인 설정·세션 파일이 생겨도 올라가지 않게 한다.
.codex/*
!.codex/hooks.json

# 하네스 초기 설정 작업서(일회성 개인 작업 문서). 결과물은 docs/harness.md에 있다.
/HARNESS_SETUP*.md


