# Dotenv
*.env
.env*
!.env.example

# Signing & credentials (never commit)
# android/.gitignore covers these under android/ only — these catch them anywhere.
*.jks
*.keystore
key.properties
*.p12
*.p8
*.pem
*.cer
*.certSigningRequest
*.mobileprovision

# Release binaries
*.apk
*.aab
*.ipa

