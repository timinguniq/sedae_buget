#!/usr/bin/env bash
# 실제 Git pre-commit 훅.
# 훅 파일의 위치가 아니라 커밋 대상 작업 트리의 게이트를 실행한다.
# 등록: git config --local core.hooksPath .githooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)" || {
  echo "pre-commit: 차단 — 작업 트리 루트를 구할 수 없습니다." >&2
  exit 1
}
gate="$root/tool/commit_gate.sh"
if [ ! -f "$gate" ]; then
  echo "pre-commit: 차단 — 이 작업 트리에 게이트가 없습니다: $gate" >&2
  echo "pre-commit: 하네스가 포함된 main을 병합(또는 rebase)한 뒤 다시 커밋하세요." >&2
  exit 1
fi

cd "$root"
exec bash "$gate"
