{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tool/agent_pre_commit.py || exit 2",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
