{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tool/agent_pre_commit.py\" || exit 2",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
